{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "conversion",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_conversion.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/conversion",
      "instrumentation": [
        {
          "module": "value_conversion",
          "functions": [
            "convert_value"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    "fuzz",
    "patterns"
  ]
}
