{
  "repository": "victron-venus/venus-os-integration-patterns",
  "mode": "release",
  "default_branch": "main",
  "validation_workflows": [
    "validate.yml",
    "codeql.yml",
    "dependency-review.yml"
  ],
  "local_checks": [
    "bash scripts/ci.sh"
  ],
  "notes": [
    "The actual MQTT-to-D-Bus numeric conversion has been extracted into an importable pure helper. The running bridge calls that helper; the fuzz target exercises finite values, representable integer bounds, booleans, strings and conversion stability without importing D-Bus/GLib or opening MQTT connections.",
    "Versioned artifacts are the reviewed source suite, not a firmware or deployment. Existing ordinary application, container, dependency and CodeQL checks remain required."
  ],
  "visibility": "public",
  "single_entry_ci": true,
  "schema": 1,
  "version_file": "SOURCE_VERSION",
  "release_notes": "CHANGELOG.md",
  "artifact_pattern": "release-assets*",
  "container_assets": {},
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "toolkit_revision": "21f8041a2a11a13367f49a37e624ac51ab8c4481",
    "files": [
      {
        "path": "SOURCE_VERSION",
        "format": "text",
        "value": "package"
      }
    ],
    "artifacts": [
      {
        "path": "venus-os-integration-patterns-*.tar.gz",
        "format": "tar-text",
        "member": "venus-os-integration-patterns/SOURCE_VERSION",
        "value": "package"
      }
    ],
    "required_build_receipts": [
      "release-inputs-package.json"
    ]
  },
  "fuzzing": {
    "toolkit_ref": "77b0157695fb80e4d97c3ac4819c2d1db7ba96c7"
  },
  "toolkit_revision": "21f8041a2a11a13367f49a37e624ac51ab8c4481",
  "change_scope": {
    "documentation_paths": [
      "GOVERNANCE.md",
      "patterns/dbus-to-mqtt/README.md",
      "patterns/http-api-wrapper/README.md",
      "patterns/mqtt-to-dbus/README.md"
    ],
    "required_paths": [
      "CHANGELOG.md"
    ],
    "always_validate_workflows": [
      "codeql.yml"
    ]
  }
}
