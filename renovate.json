{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "custom.jsonata",
    "custom.regex",
    "docker-compose",
    "dockerfile",
    "github-actions",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    "security/provider/**",
    "build-support/tls-armv7/**"
  ],
  "packageRules": [
    {
      "description": "Generated locks are updated by pip-compile through their recorded source inputs; never edit the output pins independently.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "patterns/mqtt-to-dbus/requirements-build.txt"
      ],
      "enabled": false
    },
    {
      "description": "The hash-locked PyYAML dependency requires Python 3.14 wheels. Keep patch and digest updates on this qualified minor until its dependency lock supports the next Python minor.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchFileNames": [
        "patterns/mqtt-to-dbus/Dockerfile"
      ],
      "allowedVersions": "/^3\\.14(?:[.-]|$)/"
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      "security/provider/**",
      "build-support/tls-armv7/**",
      ".github/requirements-bridge-tests.txt",
      "patterns/mqtt-to-dbus/requirements-build.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^patterns/mqtt\\-to\\-dbus/requirements\\-build\\.txt$/",
      "/^\\.github/requirements\\-bridge\\-tests\\.txt$/"
    ]
  }
}
